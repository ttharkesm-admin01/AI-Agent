# --- Required (unless you use `ant auth login`) ---
# Anthropic API key: https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides ---
# Model to use (default: claude-opus-4-8)
#AI_AGENT_MODEL=claude-opus-4-8

# Reasoning effort: low | medium | high | xhigh | max (default: high)
#AI_AGENT_EFFORT=high

# Extra skills directory, in addition to ./skills in this repo.
# Point this at a clone of thananon/9arm-skills or your own skills folder.
#AI_AGENT_SKILLS_DIR=~/.ai-agent/skills

# Skip y/N confirmation before bash/write/edit tools (default: confirmations ON)
#AI_AGENT_AUTO_APPROVE=1

# --- Corporate network (e.g. CPF office machine) ---
# Outbound proxy for HTTPS traffic
#HTTPS_PROXY=http://proxy.example.com:8080

# Internal API gateway, if your company routes Anthropic traffic through one
#ANTHROPIC_BASE_URL=https://api.anthropic.com
